---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { siteConfig, townSlug } from '../config/site.config';

const bodies = import.meta.glob('../towns/*/About.astro', { eager: true }) as Record<string, any>;
const AboutBody = bodies[`../towns/${townSlug}/About.astro`].default;
---

<Layout title="About" description={`About ${siteConfig.brandName} — ${siteConfig.tagline} nostalgia`}>
  <Nav />
  
  <main class="bg-cream min-h-screen pt-16">
    <div class="container-custom py-16 md:py-20">
      <div class="max-w-2xl mx-auto">
        <h1 class="font-display text-4xl md:text-5xl leading-tight mb-10 text-charcoal">
          About {siteConfig.brandName}
        </h1>

        <AboutBody />
      </div>
    </div>
  </main>

  <Footer />
  <CartDrawer />
</Layout>
