---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import ProductCard from '../components/ProductCard.astro';
import { getAllProducts } from '../lib/products';

const products = (await getAllProducts()).filter(p => p.handle.startsWith('cave-tangi'));
---

<Layout
  title="Ponchatoula — the Cave Tangi"
  description="The Cave Tangi opened in October 1938 on Highway 51, just north of Ponchatoula. Tees and hats in its memory."
>
  <Nav />

  <main class="bg-cream min-h-screen pt-16">
    <div class="container-custom py-16 md:py-20">
      <div class="max-w-2xl mx-auto mb-14">
        <h1 class="font-display text-4xl md:text-5xl leading-tight mb-8 text-charcoal">
          Ponchatoula
        </h1>
        <div class="space-y-6 text-base md:text-lg leading-relaxed text-charcoal/90">
          <p>
            The Cave Tangi was Ponchatoula's. Dallas Wood opened it as a nightclub and restaurant in
            October 1938, out on Highway 51 just north of town, and about ten years later he put up the
            Cave Tangi Drive-In across the road. It showed its last picture in 1957.
          </p>
          <p>
            Hammond folks drove down for it too, and people from both towns still talk about it.
            If you have a story or an old photo, we'd love to hear it:
            <a href="mailto:info@nostalgichammond.com" class="underline">info@nostalgichammond.com</a>.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {products.map(product => (
          <ProductCard product={product} />
        ))}
      </div>
    </div>
  </main>

  <Footer />
  <CartDrawer />
</Layout>
