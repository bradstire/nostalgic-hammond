---
// Simple, always-visible dark navigation
---

<header 
  id="dark-nav" 
  class="fixed top-0 w-full z-50 bg-warm-black border-b border-rust"
  style="height: 60px;"
>
  <nav class="container-custom h-full flex items-center justify-between">
    <!-- Logo / Brand Name -->
    <a 
      href="/" 
      class="flex items-baseline gap-1.5 transition-colors group"
    >
      <span style="font-family: 'Playfair Display', serif; font-weight: 700; letter-spacing: 2px; font-size: 16px; color: #E8E0D4; text-transform: uppercase;">NOSTALGIC</span>
      <span style="font-family: 'Playfair Display', serif; font-weight: 400; font-size: 20px; color: #B85C3E; font-style: italic;">Hammond</span>
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center gap-8">
      <a href="/" class="nav-link">Shop</a>
      <a href="/about" class="nav-link">About</a>
      <button id="cart-toggle" class="relative nav-link">
        Cart
        <span id="cart-count" class="hidden absolute -top-2 -right-3 bg-rust text-warm-white text-xs rounded-full w-5 h-5 flex items-center justify-center">0</span>
      </button>
    </div>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-toggle" class="md:hidden text-warm-white">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-rust bg-warm-black">
    <div class="container-custom py-4 flex flex-col gap-4">
      <a href="/" class="mobile-nav-link">Shop</a>
      <a href="/about" class="mobile-nav-link">About</a>
      <button id="cart-toggle-mobile" class="mobile-nav-link text-left">
        Cart <span id="cart-count-mobile" class="text-rust"></span>
      </button>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  document.getElementById('mobile-menu-toggle')?.addEventListener('click', () => {
    const menu = document.getElementById('mobile-menu');
    menu?.classList.toggle('hidden');
  });

  // Update cart count
  function updateCartCount() {
    const cart = JSON.parse(localStorage.getItem('cart') || '[]');
    const count = cart.reduce((sum: number, item: any) => sum + item.quantity, 0);
    
    const badge = document.getElementById('cart-count');
    const mobileBadge = document.getElementById('cart-count-mobile');
    
    if (count > 0) {
      badge?.classList.remove('hidden');
      if (badge) badge.textContent = count.toString();
      if (mobileBadge) mobileBadge.textContent = `(${count})`;
    } else {
      badge?.classList.add('hidden');
      if (mobileBadge) mobileBadge.textContent = '';
    }
  }

  // Update on page load
  updateCartCount();

  // Listen for cart updates
  window.addEventListener('cart-updated', updateCartCount);
</script>

<style>
  .nav-link {
    font-family: sans-serif;
    font-size: 13px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #E8E0D4;
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: #B85C3E;
  }

  .mobile-nav-link {
    font-family: sans-serif;
    font-size: 13px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #E8E0D4;
    padding: 0.5rem 0;
    transition: color 0.2s;
  }

  .mobile-nav-link:hover {
    color: #B85C3E;
  }
</style>
