// Use mapped images if available, otherwise fallback to product.images
const imageSrc = productImages[product.handle]?.[0] || product.images[0].src;
const image = { src: imageSrc, alt: product.images[0].alt };

// Format price: remove trailing .0 for whole dollar amounts
const formatPrice = (price: string) => {
  const num = parseFloat(price);
  return num % 1 === 0 ? num.toFixed(0) : price;
};
---

<a 
  href={`/products/${product.handle}`}
  class="product-card group block rounded-sm overflow-hidden transition-colors duration-300"
>
  <!-- Product Image -->
  <div class="relative aspect-square overflow-hidden">
    <img
      src={image.src}
      alt={image.alt}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-charcoal/0 group-hover:bg-charcoal/5 transition-colors duration-300"></div>
  </div>

  <!-- Product Info -->
  <div class="p-5">
    <h3 class="product-title font-display text-lg leading-tight mb-2.5 text-charcoal group-hover:text-rust transition-colors duration-200">
      {product.title}
    </h3>
    <p class="product-price text-rust font-semibold tracking-wide">
      ${formatPrice(product.price)}
    </p>
  </div>
</a>

<style>
  .product-card {
    background-color: transparent;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
                box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08), 0 4px 8px rgba(0, 0, 0, 0.04);
  }
  
  .product-title {
    font-size: 1.125rem;
    line-height: 1.3;
  }
  
  .product-price {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1rem;
    letter-spacing: 0.025em;
  }
  
  @media (max-width: 768px) {
    .product-title {
      font-size: 1rem;
    }
  }
</style>
