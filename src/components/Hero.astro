---
import { town } from '../config/site.config';
---

<section id="hero" class="hero-section" style={`background-image: url('${town.heroImage}'); background-position: ${town.heroPosition};`}>
  <div class="hero-content">
    <span class="hero-nostalgic">NOSTALGIC</span>
    <hr class="hero-rule" />
    <span class="hero-hammond">{town.townName}</span>
    <span class="hero-louisiana">{town.stateName.toUpperCase()}</span>
    <span class="hero-dot">●</span>
  </div>
  <div class="scroll-indicator">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    height: 65vh;
    min-height: 450px;
    background-size: cover;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
    margin-top: 60px;
  }

  .hero-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: #2C2825;
    opacity: 0.67;
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 600px;
  }

  .scroll-indicator {
    position: absolute;
    bottom: 2.5rem;
    color: #5A5450;
    animation: scrollFloat 2.5s ease-in-out infinite, fadeInUp 1s ease-out 0.85s forwards;
    opacity: 0;
    z-index: 2;
  }

  .hero-nostalgic {
    font-family: 'Playfair Display', serif;
    font-weight: 900;
    font-style: italic;
    text-transform: uppercase;
    color: #E8E0D4;
    font-size: clamp(60px, 8vw, 100px);
    line-height: 0.95;
    letter-spacing: 0.02em;
    animation: fadeInUp 1s ease-out 0.1s forwards;
    opacity: 0;
  }

  .hero-rule {
    width: 220px;
    height: 2px;
    background-color: #B85C3E;
    border: none;
    margin: 12px 0 16px;
    animation: fadeInUp 1s ease-out 0.25s forwards;
    opacity: 0;
  }

  .hero-hammond {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 400;
    color: #C8BFB3;
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1.1;
    animation: fadeInUp 1s ease-out 0.4s forwards;
    opacity: 0;
  }

  .hero-louisiana {
    font-family: sans-serif;
    text-transform: uppercase;
    letter-spacing: 8px;
    color: #E8E0D4;
    font-size: clamp(12px, 1.5vw, 16px);
    font-weight: 400;
    margin-top: 8px;
    animation: fadeInUp 1s ease-out 0.55s forwards;
    opacity: 0;
  }

  .hero-dot {
    width: 6px;
    height: 6px;
    background-color: #B85C3E;
    border-radius: 50%;
    margin-top: 16px;
    animation: fadeInUp 1s ease-out 0.7s forwards;
    opacity: 0;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes scrollFloat {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(6px);
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      min-height: max(50vh, 350px);
      padding: 2.5rem 1.25rem;
    }
    
    .hero-louisiana {
      letter-spacing: 0.3em;
    }
  }
</style>
