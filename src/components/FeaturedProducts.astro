---
// Dual hero section with featured products
---

<section class="featured-section">
  <div class="container-custom">
    <div class="featured-grid">
      <!-- Product 1: Cave Tangi Tee Black -->
      <a href="/products/cave-tangi-tee-black" class="featured-card">
        <div class="featured-badge">BEST SELLER</div>
        <div class="featured-image-wrapper">
          <img 
            src="/images/tee-black-01.png" 
            alt="Cave Tangi Tee — Black" 
            class="featured-image"
            loading="eager"
          />
        </div>
        <div class="featured-content">
          <h3 class="featured-title">Cave Tangi Tee — Black</h3>
          <p class="featured-price">$34</p>
        </div>
      </a>

      <!-- Product 2: Hammond Phys Ed Ringer Tee -->
      <a href="/products/hammond-phys-ed-ringer-tee" class="featured-card">
        <div class="featured-badge featured-badge-alt">FEATURED</div>
        <div class="featured-image-wrapper">
          <img 
            src="/images/ringer-tee-01.png" 
            alt="Hammond Phys Ed Ringer Tee" 
            class="featured-image"
            loading="eager"
          />
        </div>
        <div class="featured-content">
          <h3 class="featured-title">Hammond Phys Ed Ringer Tee</h3>
          <p class="featured-price">$34</p>
        </div>
      </a>
    </div>

    <!-- View All Link -->
    <div class="featured-cta">
      <a href="#collection" class="view-all-link">View All Products</a>
    </div>
  </div>
</section>

<style>
  .featured-section {
    background-color: #F5F0E6;
    padding: 3rem 0;
    border-bottom: 1px solid #E8E0D4;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }

    .featured-section {
      padding: 4rem 0;
    }
  }

  .featured-card {
    position: relative;
    display: block;
    background-color: #E8E0D4;
    border: 1px solid #C8BFB3;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
  }

  .featured-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(44, 40, 37, 0.15);
  }

  .featured-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: #2C2825;
    color: #E8E0D4;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.375rem 0.75rem;
    z-index: 10;
  }

  .featured-badge-alt {
    background-color: #B85C3E;
  }

  .featured-image-wrapper {
    aspect-ratio: 1;
    overflow: hidden;
    background-color: #E8E0D4;
  }

  .featured-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .featured-card:hover .featured-image {
    transform: scale(1.05);
  }

  .featured-content {
    padding: 1.5rem;
  }

  .featured-title {
    font-family: 'Playfair Display', serif;
    font-weight: 400;
    font-size: 20px;
    color: #2C2825;
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }

  .featured-price {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 18px;
    font-weight: 600;
    color: #8C8578;
    margin: 0;
  }

  .featured-cta {
    text-align: center;
  }

  .view-all-link {
    display: inline-block;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #2C2825;
    text-decoration: none;
    padding: 0.75rem 2rem;
    border: 2px solid #C8BFB3;
    background-color: transparent;
    transition: all 0.2s ease;
  }

  .view-all-link:hover {
    background-color: #2C2825;
    color: #E8E0D4;
    border-color: #2C2825;
  }

  @media (max-width: 767px) {
    .featured-content {
      padding: 1.25rem;
    }

    .featured-title {
      font-size: 18px;
    }

    .featured-price {
      font-size: 16px;
    }
  }
</style>

<script>
  // Smooth scroll to collection section
  document.querySelector('.view-all-link')?.addEventListener('click', (e) => {
    e.preventDefault();
    const collection = document.querySelector('#collection');
    if (collection) {
      collection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });
</script>
