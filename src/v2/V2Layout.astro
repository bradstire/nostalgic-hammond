---
import './v2.css';
import { siteConfig, town } from '../config/site.config';
import Header from './components/Header.astro';
import Footer from './components/Footer.astro';
import CartDrawer from './components/CartDrawer.astro';
import { COPY } from './data';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonld?: object[];
  noHeader?: boolean;
  noindex?: boolean;
}
const {
  title,
  description = COPY.metaDescription,
  image = COPY.ogImage,
  jsonld = [],
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} | ${siteConfig.brandName}` : `${siteConfig.brandName}: ${COPY.homeTitle}`;
const canonical = new URL(Astro.url.pathname, siteConfig.siteUrl).href;
const ogImage = new URL(image, siteConfig.siteUrl).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(!town.launched || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#1f3d2e" />
    <link rel="icon" href={`${siteConfig.iconDir}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${siteConfig.iconDir}/apple-touch-icon.png`} />
    <meta property="og:site_name" content={siteConfig.brandName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
    <script is:inline>
      window.nhTrack = window.nhTrack || function () {};
      /* Internal-traffic flag + first-touch source (NT goal ledger).
         ?hq=1 marks this browser as HQ/QA (no pixel events, carts tagged "hq"); ?hq=0 clears it.
         Headless/automated browsers are treated as internal too. */
      (function () {
        try {
          var q = new URLSearchParams(location.search), ls = window.localStorage, ss = window.sessionStorage;
          if (q.get('hq') === '1') ls.setItem('nt_hq', '1'); else if (q.get('hq') === '0') ls.removeItem('nt_hq');
          window.NT_HQ = !!ls.getItem('nt_hq') || !!navigator.webdriver || /HeadlessChrome|Lighthouse/.test(navigator.userAgent);
          if (!ss.getItem('nt_src')) {
            var ref = ''; try { ref = document.referrer ? new URL(document.referrer).hostname : ''; } catch (e) {}
            if (ref === location.hostname) ref = '';
            var src = [q.get('utm_source') || (ref || 'direct'), q.get('utm_medium') || '', q.get('utm_campaign') || '', location.pathname].join('|');
            ss.setItem('nt_src', src.slice(0, 250));
          }
        } catch (e) { window.NT_HQ = false; }
      })();
    </script>
    {siteConfig.metaPixelId && (
      <script is:inline define:vars={{ pixelId: siteConfig.metaPixelId }}>
        if (!window.NT_HQ) {
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
        n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
        document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', pixelId); fbq('track', 'PageView');
        window.nhTrack = function (name, params, eventID) {
          try { window.fbq && window.fbq('track', name, params || {}, eventID ? { eventID: eventID } : undefined); } catch (e) {}
        };
        }
      </script>
    )}
  </head>
  <body>
    <a class="hb-skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CartDrawer />
  </body>
</html>
