---
import type { V2Product } from '../catalog';
import { cdn, srcset, money } from '../catalog';
import { nw } from '../nw';
interface Props { p: V2Product; eager?: boolean; sizes?: string; badge?: string; heading?: 'h3' | 'span' }
const { p, eager = false, sizes = '(max-width: 760px) 50vw, (max-width: 1080px) 33vw, 300px', badge } = Astro.props;
// Cards lead with the cut-out product (transparent background); the print close-up shows on hover.
const detailFirst = false;
const main = p.images[0];
const sib = p.family.find((f) => f.handle !== p.handle && f.image);
const alt2 = p.detail ? null : sib?.image ? { url: sib.image } : p.images[1];
const typeLabel = p.type === 'Framed print' ? 'Print' : p.type;
const swatches = p.family.length > 1 ? p.family.map((f) => ({ name: f.label, hex: f.hex })) : p.colors;
const swLabel = swatches.length > 1 ? `${swatches.length} colors: ${swatches.map((c) => c.name).join(', ')}` : '';
---
<a class="hb-card" href={`/products/${p.handle}`}>
  <div class="hb-card__media">
    {badge && <span class="hb-badge">{badge}</span>}
    {detailFirst ? (
      <Fragment>
        <img src={`${p.detail}-540.webp`} srcset={`${p.detail}-360.webp 360w, ${p.detail}-540.webp 540w, ${p.detail}-800.webp 800w`} sizes={sizes}
          width="540" height="540" alt={`${p.baseTitle}, print close-up`} loading={eager ? 'eager' : 'lazy'} decoding="async" />
        {main && <img class="hb-card__alt hb-cut" src={cdn(main.url, 540)} srcset={srcset(main.url)} sizes={sizes} width="540" height="540" alt="" aria-hidden="true" loading="lazy" decoding="async" />}
      </Fragment>
    ) : main && (
      <img class="hb-cut" src={cdn(main.url, 540)} srcset={srcset(main.url)} sizes={sizes} width="540" height="540"
        alt={p.baseTitle} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    )}
    {detailFirst ? null : p.detail ? (
      <img class="hb-card__alt" src={`${p.detail}-540.webp`} srcset={`${p.detail}-360.webp 360w, ${p.detail}-540.webp 540w, ${p.detail}-800.webp 800w`} sizes={sizes}
        width="540" height="540" alt="" aria-hidden="true" loading="lazy" decoding="async" />
    ) : alt2 ? (
      <img class="hb-card__alt hb-cut" src={cdn(alt2.url, 540)} srcset={srcset(alt2.url)} sizes={sizes} width="540" height="540" alt="" aria-hidden="true" loading="lazy" decoding="async" />
    ) : null}
  </div>
  <div class="hb-card__body">
    <span class="hb-card__place">{p.place ? p.place.short : 'Hattiesburg'} · {typeLabel}</span>
    <span class="hb-card__title" set:html={nw(p.baseTitle)} />
    <div class="hb-card__meta">
      <span class="hb-card__price">{money(p.price)}</span>
      {swatches.length > 1 && (
        <span class="hb-swatches" role="img" aria-label={swLabel}>
          {swatches.slice(0, 4).map((c) => <span class="hb-sw" style={`background:${c.hex}`}></span>)}
        </span>
      )}
    </div>
  </div>
</a>
