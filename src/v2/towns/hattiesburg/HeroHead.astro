// Hattiesburg home: preload the postcard hero (rendered into the layout's <head>).
---
<link rel="preload" as="image" type="image/avif" media="(min-width: 901px)" imagesrcset="/images/hb/hero/wide-800.avif 800w, /images/hb/hero/wide-1200.avif 1200w, /images/hb/hero/wide-1600.avif 1600w, /images/hb/hero/wide-2400.avif 2400w" imagesizes="(min-width: 1240px) 900px, 80vw" fetchpriority="high" />{' '}<link rel="preload" as="image" type="image/avif" media="(max-width: 900px)" imagesrcset="/images/hb/hero/stack-600.avif 600w, /images/hb/hero/stack-750.avif 750w, /images/hb/hero/stack-900.avif 900w, /images/hb/hero/stack-1200.avif 1200w" imagesizes="calc(100vw - 32px)" fetchpriority="high" />
