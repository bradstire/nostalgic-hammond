---
import V2Layout from '../V2Layout.astro';
import { FAQ, FREE_SHIP, HOLIDAY_CUTOFF, COPY } from '../data';
import { siteConfig } from '../../config/site.config';
// Town-specific /about body (src/v2/towns/<town>/About.astro).
import About from '@town/About.astro';
interface Props { page: 'about' | 'faq' | 'shipping-returns' | 'terms' | 'contact' }
const { page } = Astro.props;
const email = siteConfig.contactEmail;
const titles = { about: 'Our story & sources', faq: 'Help & FAQ', 'shipping-returns': 'Shipping & returns', terms: 'Terms of service', contact: 'Contact us' };
const descs = {
  about: COPY.aboutDesc,
  faq: `Sizing, shipping times, returns and more for ${siteConfig.brandName} orders.`,
  'shipping-returns': `Free US shipping on orders $${FREE_SHIP}+, made-to-order timing, and our misprint and damage replacement policy.`,
  terms: `Terms of service for ${new URL(siteConfig.siteUrl).hostname.replace(/^www\./, '')}.`,
  contact: `Questions about an order, sizing or a place we should bring back? Here is how to reach ${siteConfig.brandName}.`,
};
const jsonld = page === 'faq' ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : [];
---
<V2Layout title={titles[page]} description={descs[page]} jsonld={jsonld}>
  <section class="hb-section--tight">
    <div class="hb-wrap hb-prose">
      <p class="hb-eyebrow">{page === 'about' ? siteConfig.brandName : 'Help'}</p>
      <h1 class="hb-h1" style="font-size:clamp(2rem,4vw,3rem)">{titles[page]}</h1>

      {page === 'about' && <About />}

      {page === 'contact' && (
        <Fragment>
          <p class="hb-lede">Questions about an order or sizing, or a place we should bring back? We read every message and usually reply within one business day.</p>
          <div class="hb-contact">
            <p class="hb-contact__k">Email</p>
            <p class="hb-contact__v"><a href={`mailto:${email}`}>{email}</a></p>
            <button class="hb-btn hb-btn--ghost" type="button" data-copy={email}>Copy email address</button>
            <p class="hb-note" role="status" aria-live="polite" data-copy-msg></p>
          </div>
          <h2>About an order</h2>
          <p>Include your order number and, if something arrived misprinted or damaged, a photo. We'll send a replacement or refund at no cost. See <a href="/shipping-returns">shipping &amp; returns</a>.</p>
          <h2>A place to remember</h2>
          <p>Have an old photo, ad or postcard of a {siteConfig.townName} place? Send it along with anything you remember about it. Every design starts with a source like that.</p>
        </Fragment>
      )}

      {page === 'faq' && (
        <Fragment>
          <div class="hb-faq" style="margin-top:20px">
            {FAQ.map((f, i) => (<details open={i < 2}><summary>{f.q}</summary><p>{f.a}</p></details>))}
            <details><summary>How do I contact you?</summary><p>Email <a class="hb-link" href={`mailto:${email}`}>{email}</a> or see our <a class="hb-link" href="/contact">contact page</a>. We usually reply within one business day.</p></details>
            <details><summary>Can I ship a gift straight to someone?</summary><p>Yes. Enter their address at checkout. We don't offer gift cards yet.</p></details>
          </div>
        </Fragment>
      )}

      {page === 'shipping-returns' && (
        <Fragment>
          <p class="hb-lede">Everything we sell is printed or embroidered to order, just for you. Here's what that means for timing and returns.</p>
          <h2>Shipping</h2>
          <ul>
            <li><strong>Free US shipping</strong> on orders of ${FREE_SHIP} or more after discounts. Under ${FREE_SHIP}, shipping is calculated at checkout before you pay.</li>
            <li><strong>Production:</strong> most orders ship in 2–5 business days.</li>
            <li><strong>Delivery:</strong> usually 3–4 business days to most US addresses after your order ships. You'll get a tracking link by email.</li>
            <li><strong>Holidays:</strong> order by {HOLIDAY_CUTOFF} with standard shipping for Christmas delivery.</li>
            <li>Items in one order may ship separately and arrive on different days.</li>
            <li>We currently ship to US addresses only.</li>
          </ul>
          <h2>Returns & replacements</h2>
          <ul>
            <li><strong>Misprinted, damaged or wrong item?</strong> Email <a href={`mailto:${email}`}>{email}</a> within 30 days of delivery with your order number and a photo. We'll send a replacement or refund at no cost to you.</li>
            <li><strong>Fit or change of mind:</strong> because each piece is made just for you, we can't accept returns or exchanges for size or preference. Please check the size chart on each product page, and email us if you'd like help choosing.</li>
            <li><strong>Lost or returned packages:</strong> if a package is marked delivered but missing, or comes back to us because of an address issue, email us and we'll work it out with you.</li>
          </ul>
          <h2>Questions</h2>
          <p>Email <a href={`mailto:${email}`}>{email}</a>. We usually reply within one business day.</p>
        </Fragment>
      )}

      {page === 'terms' && (
        <Fragment>
          <p class="hb-lede">These terms cover your use of this site and purchases made through it. By placing an order you agree to them.</p>
          <h2>Orders and pricing</h2>
          <p>Prices are in US dollars. Checkout, payment and order processing are handled by Shopify. We may cancel an order and refund it in full if a product becomes unavailable or a price was shown in error.</p>
          <h2>Made to order</h2>
          <p>Products are printed or embroidered after you order. Colors on screen can differ slightly from the finished product. Our <a href="/shipping-returns">shipping and returns policy</a> is part of these terms.</p>
          <h2>Our artwork</h2>
          <p set:html={COPY.termsArtworkHtml} />
          <h2>No affiliation</h2>
          <p>{siteConfig.brandName} is an independent tribute shop. We are not affiliated with or endorsed by the businesses, schools or institutions shown, and any names are used to describe the history our designs honor.</p>
          <h2>Privacy</h2>
          <p>See our <a href="https://checkout.shopify.com/97765622131/policies/50774835571.html?locale=en" rel="nofollow">privacy policy</a> for how we handle your information, including email signups and advertising cookies.</p>
          <h2>Contact</h2>
          <p><a href={`mailto:${email}`}>{email}</a></p>
          <p class="hb-note">Last updated October 2026.</p>
        </Fragment>
      )}
    </div>
  </section>
</V2Layout>

<script>
  document.querySelector('[data-copy]')?.addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLElement; const m = document.querySelector('[data-copy-msg]') as HTMLElement;
    try { await navigator.clipboard.writeText(b.dataset.copy || ''); m.textContent = 'Copied. Paste it into your email app.'; }
    catch { m.textContent = 'Copy failed. Press and hold the address above to copy it.'; }
  });
</script>
