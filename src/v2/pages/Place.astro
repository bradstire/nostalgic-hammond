---
import V2Layout from '../V2Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getCatalog } from '../catalog';
import { TYPE_ORDER, PLACE_DIR, SHOP_ORDER, livePlaces, placeStory, placeSources, type Place } from '../data';
import { siteConfig, town } from '../../config/site.config';
import { nw } from '../nw';
import { clip } from '../clip';
interface Props { pl: Place }
const { pl } = Astro.props;
const all = await getCatalog();
const rank = (h: string) => { const i = SHOP_ORDER.indexOf(h); return i < 0 ? 1e4 : i; };
const items = all.filter((p) => p.lead && p.place?.slug === pl.slug).sort((a, b) => TYPE_ORDER.indexOf(a.type) - TYPE_ORDER.indexOf(b.type) || rank(a.handle) - rank(b.handle));
const others = livePlaces(all).filter((x) => x.slug !== pl.slug);
const big = !!pl.tileTall;
const handles = all.map((p) => p.handle);
const story = placeStory(pl, handles);
const sources = placeSources(pl, handles);
const T = siteConfig.townName;
const jsonld = [{
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.siteUrl + '/' },
    { '@type': 'ListItem', position: 2, name: 'Places', item: `${siteConfig.siteUrl}/places` },
    { '@type': 'ListItem', position: 3, name: pl.name, item: `${siteConfig.siteUrl}/places/${pl.slug}` },
  ],
}, {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: `${pl.name}: ${T} tees, hats & prints`, url: `${siteConfig.siteUrl}/places/${pl.slug}`,
  about: { '@type': 'Place', name: `${pl.name}, ${pl.locality || T}, ${town.stateName}` },
}];
---
<V2Layout title={pl.name.includes(T) ? pl.name : `${pl.name}, ${T}`} description={clip(story[0])} image={`${PLACE_DIR}/${pl.tile}-900.jpg`} jsonld={jsonld}>
  <div class="hb-wrap">
    <nav class="hb-crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/places">Places</a></li><li aria-current="page">{pl.short}</li></ol></nav>
  </div>
  <section class="hb-section--tight">
    <div class="hb-wrap" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(24px,4vw,56px);align-items:center" data-place-hero>
      <div>
        {pl.era && <p class="hb-eyebrow"><span class="hb-era">{pl.era}</span></p>}
        <h1 class="hb-h1" style="font-size:clamp(2rem,4.4vw,3.4rem)" set:html={nw(pl.name)} />
        {story.map((s, i) => <p class={i === 0 ? 'hb-lede' : ''} style={i ? 'color:var(--ink-2);max-width:36em' : ''}>{s}</p>)}
        {pl.facts.length > 0 && <dl style="display:flex;flex-wrap:wrap;gap:12px 28px;margin:22px 0 0">
          {pl.facts.map((f) => <div><dt class="hb-card__place">{f.k}</dt><dd style="margin:2px 0 0;font-weight:650">{f.v}</dd></div>)}
        </dl>}
        <a class="hb-btn hb-btn--primary" href="#pieces" style="margin-top:24px">{items.length === 1 ? `Shop the ${items[0].type.toLowerCase()}${items[0].family.length > 1 ? ` · ${items[0].family.length} colors` : ''}` : `Shop ${items.length} designs`}</a>
      </div>
      <div style={`border-radius:var(--radius);overflow:hidden;background:${pl.tone};border:1px solid rgba(30,26,22,.12)`}>
        <picture>
          <source type="image/avif" srcset={`${PLACE_DIR}/${pl.tile}-600.avif 600w, ${PLACE_DIR}/${pl.tile}-900.avif 900w`} sizes="(max-width: 900px) 100vw, 560px" />
          <img src={`${PLACE_DIR}/${pl.tile}-900.webp`} srcset={`${PLACE_DIR}/${pl.tile}-600.webp 600w, ${PLACE_DIR}/${pl.tile}-900.webp 900w`} sizes="(max-width: 900px) 100vw, 560px" width="900" height={big ? 900 : 675} alt={`${pl.name} artwork from the ${siteConfig.brandName} collection`} fetchpriority="high" />
        </picture>
      </div>
    </div>
  </section>
  <section class="hb-section--tight" id="pieces" aria-labelledby="pieces-h">
    <div class="hb-wrap">
      <div class="hb-head"><h2 class="hb-h2" id="pieces-h" set:html={nw(pl.catchAll ? pl.short : `${pl.short.startsWith('The ') ? pl.short : 'The ' + pl.short} collection`)} />{pl.note && <p class="hb-note" style="margin:0">{pl.note}</p>}</div>
      <div class={`hb-grid${items.length <= 2 ? ' hb-grid--few' : ''}`}>{items.map((p, i) => <ProductCard p={p} eager={i < 2} />)}</div>
      <aside class="hb-sources" aria-labelledby="src-h">
        <h3 id="src-h">{sources.length ? 'Sources' : 'Know more?'}</h3>
        {sources.length > 0 && <ul>{sources.map((s) => <li>{s.url ? <a class="hb-link" href={s.url} rel="nofollow noopener">{s.label}</a> : s.label}</li>)}</ul>}
        <p class="hb-note">{pl.catchAll ? `Know a ${T} place we should bring back?` : `Know more about ${pl.short.replace(/^The /, 'the ')}?`} Have a photo? <a class="hb-link" href={`mailto:${siteConfig.contactEmail}?subject=${encodeURIComponent(pl.short)}`}>Tell us</a>.</p>
      </aside>
    </div>
  </section>
  <section class="hb-section--tight" style="border-top:1px solid var(--line)" aria-labelledby="more-h">
    <div class="hb-wrap">
      {others.length > 0 && <h2 class="hb-h2" id="more-h" style="font-size:clamp(1.4rem,2.4vw,1.9rem);margin-bottom:18px">More {T} places</h2>}
      <div class="hb-filters">{others.map((o) => <a class="hb-chip" href={`/places/${o.slug}`}>{o.short}</a>)}</div>
    </div>
  </section>
</V2Layout>
<style>
  @media (max-width: 900px) { [data-place-hero] { grid-template-columns: 1fr !important; } [data-place-hero] > div:last-child { order: -1; } }
</style>
