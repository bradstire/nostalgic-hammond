---
import V2Layout from '../V2Layout.astro';
---
<V2Layout title="Page not found" noindex>
  <section class="hb-section">
    <div class="hb-wrap hb-prose">
      <p class="hb-eyebrow">404</p>
      <h1 class="hb-h1" style="font-size:clamp(2rem,4vw,3rem)">This place closed a long time ago.</h1>
      <p class="hb-lede">The page you're looking for isn't here. The good stuff is.</p>
      <div class="hb-hero__ctas"><a class="hb-btn hb-btn--primary" href="/shop">Shop the collection</a><a class="hb-btn hb-btn--ghost" href="/">Back home</a></div>
    </div>
  </section>
</V2Layout>
